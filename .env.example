# Billie — every setting the app reads. Copy to .env for local work.
# Secrets go in Vercel → Project → Settings → Environment Variables, never in git.

# ── Database (Neon Postgres) ───────────────────────────────────────────────
# Pooled connection for the app; the direct one runs migrations on deploy.
# The Neon ↔ Vercel integration fills these in for you.
DATABASE_URL=postgres://user:password@ep-example-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=verify-full
DIRECT_DATABASE_URL=postgres://user:password@ep-example.eu-west-2.aws.neon.tech/neondb?sslmode=verify-full
# Wiped by the tests: never point these at real data.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/billie_test
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/billie_e2e

# ── Sign-in (Neon Auth) ────────────────────────────────────────────────────
# Neon Console → your project → Auth → Configuration → Auth URL (not a secret).
NEON_AUTH_BASE_URL=https://ep-example.neonauth.eu-west-2.aws.neon.tech/neondb/auth
# Signs Neon Auth's session cookie: 32+ random characters, its own value
# (never reuse another secret). Required whenever NEON_AUTH_BASE_URL is set.
NEON_AUTH_COOKIE_SECRET=
# Only this address can create the first admin account (required on Vercel).
FIRST_ADMIN_EMAIL=you@media10.com
# Tests and offline work only: an in-memory stand-in for Neon Auth.
# Ignored when NEON_AUTH_BASE_URL is set; refused on Vercel.
BILLIE_LOCAL_AUTH=

# ── Core secret ────────────────────────────────────────────────────────────
# A long random value (e.g. `openssl rand -base64 32`). Vercel Cron sends it to
# /api/cron/*; it's also the set-up code for creating the first admin.
CRON_SECRET=

# ── App ────────────────────────────────────────────────────────────────────
# Public address for links, embed code and QR codes (Vercel's URL is used when unset).
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BRAND_NAME=Billie

# ── Claude (answers and email drafts) ──────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional model overrides.
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_SMART=
# "fake" gives canned answers for tests; refused on Vercel production.
AI_PROVIDER=

# ── Search embeddings (Voyage AI) ──────────────────────────────────────────
VOYAGE_API_KEY=
VOYAGE_MODEL=
EMBEDDINGS_PROVIDER=

# ── File storage (Vercel Blob, private) ────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Email out (Resend): invitations, alerts, staff replies ─────────────────
RESEND_API_KEY=
EMAIL_FROM=Billie <billie@yourdomain.com>

# ── Exhibitor mailbox (Microsoft 365 / Outlook via Microsoft Graph) ─────────
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=exhibitors@yourdomain.com

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=

# ── Microsoft Teams alerts (Workflows webhook) ─────────────────────────────
TEAMS_WEBHOOK_URL=
